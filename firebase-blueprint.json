{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and account settings in CodeForge",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-zA-Z0-9_]{3,30}$" },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "emailVerified": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "defaultLanguage": { "type": "string", "maxLength": 30 },
        "githubUrl": { "type": "string", "maxLength": 200 },
        "linkedinUrl": { "type": "string", "maxLength": 200 },
        "websiteUrl": { "type": "string", "maxLength": 200 },
        "isPublic": { "type": "boolean" }
      },
      "required": ["uid", "fullName", "username", "email", "createdAt", "updatedAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique username claim document to prevent duplicate usernames",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-zA-Z0-9_]{3,30}$" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "userId", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "CodeForge workspace project entity",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerUsername": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 100, "minLength": 1 },
        "description": { "type": "string", "maxLength": 500 },
        "language": { "type": "string", "maxLength": 30 },
        "visibility": { "type": "string", "enum": ["private", "unlisted", "public"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastOpenedAt": { "type": "string", "format": "date-time" },
        "isFavorite": { "type": "boolean" },
        "filesCount": { "type": "number" }
      },
      "required": ["projectId", "ownerId", "name", "language", "visibility", "createdAt", "updatedAt"]
    },
    "ProjectFile": {
      "title": "ProjectFile",
      "description": "Source code file inside a project",
      "type": "object",
      "properties": {
        "fileId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "path": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 500000 },
        "language": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "size": { "type": "number" }
      },
      "required": ["fileId", "projectId", "name", "path", "content", "createdAt", "updatedAt"]
    },
    "Execution": {
      "title": "Execution",
      "description": "Execution run history record",
      "type": "object",
      "properties": {
        "executionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectName": { "type": "string", "maxLength": 100 },
        "language": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["Running", "Success", "Compilation Error", "Runtime Error", "Timeout", "Failed"] },
        "executionTime": { "type": "number" },
        "memoryUsage": { "type": "string", "maxLength": 50 },
        "exitCode": { "type": "number" },
        "output": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["executionId", "userId", "projectId", "language", "status", "createdAt"]
    },
    "SharedProject": {
      "title": "SharedProject",
      "description": "Secure share link record for projects",
      "type": "object",
      "properties": {
        "shareId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "permission": { "type": "string", "enum": ["view", "fork"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shareId", "projectId", "ownerId", "permission", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation report",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["project", "shared", "profile"] },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Open", "Reviewing", "Resolved", "Dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "reporterId", "targetId", "targetType", "reason", "status", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Platform administrator access control record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/usernames/{username}": {
      "schema": "UsernameClaim",
      "description": "Reserved usernames to guarantee uniqueness"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User code projects"
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": "ProjectFile",
      "description": "Files belonging to a project"
    },
    "/users/{userId}/executions/{executionId}": {
      "schema": "Execution",
      "description": "Code execution logs"
    },
    "/sharedProjects/{shareId}": {
      "schema": "SharedProject",
      "description": "Share links for public or forked viewing"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Moderation reports"
    },
    "/admins/{userId}": {
      "schema": "AdminRecord",
      "description": "Designated admin users"
    }
  }
}
